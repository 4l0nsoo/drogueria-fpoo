- nombre: string
- formaDePresentacion: int
- cantidadDisponible: int
- costoDeCompra: float
- precioDeVenta: float

+ CMedicamento(id, nombre, forma, cantidad, costo, precio)
+ getId(): int
+ getNombre(): string
+ getFormaDePresentacion(): int
+ getCantidadDisponible(): int
+ getCostoDeCompra(): float
+ getPrecioDeVenta(): float
+ setCantidadDisponible(cantidad)
+ mostrarMedicamento()
}

class CInventario{
